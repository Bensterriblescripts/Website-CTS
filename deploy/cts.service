[Unit]
Description=cts website (www.cts.co.nz)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cts
WorkingDirectory=/srv/cts
Environment=CTS_ADDR=0.0.0.0:9050
Environment=CTS_PUBLIC=/srv/cts/public
Environment=CTS_CANONICAL_HOST=www.cts.co.nz
Environment=RUST_LOG=info
EnvironmentFile=/etc/cts/cts.env
Restart=on-failure
RestartSec=5
KillSignal=SIGINT

DynamicUser=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
